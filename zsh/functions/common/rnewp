# shellcheck shell=bash

# Create a new rex session within a project folder and switch to it
# If the session already exists, switch to that one

emulate -L zsh

# Fail if PROJECTS_HOME is not set
if [[ -z ${PROJECTS_HOME+x} ]]; then
  echo "Please set \$PROJECTS_HOME"
  sleep 2
  return 1
fi

# Modify display if inside a rex floating layer
if [[ -n "$REX_POPUP" ]]; then
  # Header shows the terminal title, not the block label (open Rex feature request), so set it here
  print -n '\e]0;Project Sessions\a'
  fzf_args=(--border none)
else
  fzf_args=(--height 40% --border sharp)
fi

find_output=$(find "$PROJECTS_HOME" -mindepth 2 -maxdepth 2 -type d | sed "s:$PROJECTS_HOME\/::g")
project_dir=$(echo "$find_output" | fzf --header='Projects' "${fzf_args[@]}")

[[ -z "$project_dir" ]] && return

project_path="$PROJECTS_HOME/$project_dir"
session_name=$(basename "$project_path" | sed 's/\./-/g')

[[ -z "$session_name" ]] && return 1

session_id=$(rex ls --json | jq -r --arg l "$session_name" 'first(.sessions[] | select(.label == $l) | .session_id) // empty')

# If session doesn't exist, create it
if [[ -z "$session_id" ]]; then
  # Convention for docker based projects
  cwd=$project_path
  [[ -d "$project_path/site" ]] && cwd="$project_path/site"
  session_id=$(rex new "$session_name" -c "$cwd" --json | jq -r '.session_id') || return 1
fi

rex do session.select session_id="$session_id"
