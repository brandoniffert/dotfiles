#!/usr/bin/env bash

nvim_cmd=(nvim)
if [[ $1 == "--clean" ]]; then
  nvim_cmd=(env NVIM_APPNAME=nvim-ephemeral nvim)
  shift
fi

input="$1"
dir="$HOME"
target=""

if [[ -d $input ]]; then
  target="$(readlink -f -- "$input")"
  dir="$target"
elif [[ -f $input ]]; then
  target="$(readlink -f -- "$input")"
  dir="$(dirname -- "$target")"
fi

if [[ -z "$target" ]]; then
  open -na Ghostty --args -e "${nvim_cmd[@]}" -c ":cd $dir"
else
  open -na Ghostty --args -e "${nvim_cmd[@]}" -c ":cd $dir" "$target"
fi
